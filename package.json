{
  "name": "canvas-of-historia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tools/tests/**/*.test.js\"",
    "gis:fetch": "node tools/gis/fetch-ne-land.js",
    "gis:build-land": "node tools/gis/build-land.js",
    "gis:land": "npm run gis:fetch && npm run gis:build-land",
    "gis:fetch-hydro": "node tools/gis/fetch-ne-hydro.js",
    "gis:build-hydro": "node tools/gis/build-hydro.js",
    "gis:hydro": "npm run gis:fetch-hydro && npm run gis:build-hydro",
    "gis:fetch-dem": "node tools/gis/fetch-dem.js",
    "gis:build-terrain": "node tools/gis/build-terrain.js",
    "gis:terrain": "npm run gis:fetch-dem && npm run gis:build-terrain",
    "gis:fetch-admin": "node tools/gis/fetch-ne-admin.js",
    "gis:build-theater": "node tools/gis/build-theater-land.js",
    "gis:theater": "npm run gis:fetch-admin && npm run gis:build-theater",
    "gis:fetch-planet-coast": "node tools/gis/fetch-planet-coast.js",
    "gis:build-coast-tiles": "node tools/gis/build-coast-tiles.js",
    "gis:coast-tiles": "npm run gis:fetch-planet-coast && npm run gis:build-coast-tiles",
    "gis:build-world-outline": "node tools/gis/build-world-outline.js",
    "gis:fetch-osm-coast": "node tools/gis/fetch-osm-coast.js",
    "gis:build-hd-coast": "node tools/gis/build-hd-coast.js",
    "gis:hd-coast": "npm run gis:fetch-osm-coast && npm run gis:build-hd-coast"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vite": "^8.1.1"
  }
}
