{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-of-historia/docs/contracts/scenario.schema.json",
  "title": "ScenarioDefinition (v1)",
  "description": "Immutable scenario definition. Loaded, validated, then frozen. Covers brief sections 4-5, 15-17.",
  "type": "object",
  "required": ["id", "name", "startDate", "mapScope", "states", "anchors"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "startDate": {
      "type": "object",
      "required": ["year", "month", "day"],
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "mapScope": {
      "type": "object",
      "required": ["focus", "bounds"],
      "additionalProperties": false,
      "properties": {
        "focus": { "type": "string" },
        "bounds": {
          "type": "object",
          "required": ["west", "south", "east", "north"],
          "additionalProperties": false,
          "properties": {
            "west": { "type": "number" },
            "south": { "type": "number" },
            "east": { "type": "number" },
            "north": { "type": "number" }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    },
    "anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/anchor" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": ["id", "name", "capitalAnchorId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "capitalAnchorId": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["id", "name", "kind", "lon", "lat"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["city", "fortress", "geographic"] },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    }
  }
}
