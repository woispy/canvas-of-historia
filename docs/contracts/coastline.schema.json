{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-of-historia/docs/contracts/coastline.schema.json",
  "title": "Coastline authority segment (v1)",
  "description": "Independent physical-geography authority layer. Never derived from province rings (brief sections 10, 13, 75). Slice samples are hand-traced; GIS pipeline data arrives Phase 4.",
  "type": "object",
  "required": ["id", "scenarioId", "points"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "scenarioId": { "type": "string" },
    "source": { "type": "string" },
    "confidence": {
      "enum": ["VERY_HIGH", "HIGH", "MEDIUM", "LOW", "SPECULATIVE"]
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "number" }, { "type": "number" }],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
