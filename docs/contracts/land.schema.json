{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-of-historia/docs/contracts/land.schema.json",
  "title": "Land authority polygon (v1)",
  "description": "Independent physical-geography authority layer for landmass fill. Rings are closed ([first] equals [last]). Coastline strokes derive from outer rings of the same source, so fill and stroke always align.",
  "type": "object",
  "required": ["id", "scenarioId", "rings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "scenarioId": { "type": "string" },
    "source": { "type": "string" },
    "confidence": {
      "enum": ["VERY_HIGH", "HIGH", "MEDIUM", "LOW", "SPECULATIVE"]
    },
    "rings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "items": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
